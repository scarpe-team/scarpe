----------- app code
Shoes.app :width => 320, :height => 420 do
  background "../static/menu-gray.png"
  background "../static/menu-top.png", :height => 50
  background "../static/menu-left.png", :top => 50, :width => 55
  background "../static/menu-right.png", :right => 0, :top => 50, :width => 55
  image "../static/menu-corner1.png", :top => 0, :left => 0
  # image "../static/menu-corner2.png", :right => 0, :top => 0
  # list_box :items => ["Phyllis", "Ronald", "Wyatt"]
  list_box(items: ["Phyllis", "Ronald", "Wyatt"])

  stack :margin => 40 do
    stack :margin => 10 do
      para "Name"
      @name = list_box :items => ["Phyllis", "Ronald", "Wyatt"]
    end
    stack :margin => 10 do
      para "Address"
      @address = edit_line
    end
    stack :margin => 10 do
      para "Phone"
      @phone = edit_line
    end
    stack :margin => 10 do
      button "Save" do
        Shoes.p [@name.text, @address.text, @phone.text]
      end
    end
  end
end
----------- test code
# Test: Form with name dropdown, address/phone inputs, save button
# Note: Uses background images that may not exist

# Two list_boxes - one standalone, one for Name field
assert list_boxes().count >= 2, "Should have list boxes"
assert_equal 2, edit_lines().count, "Should have Address and Phone inputs"
assert_equal "Save", button().text
