# Imported from Noah Gibbs' Shoes-Spec corpus by spec/import_shoes_spec.rb.
# Change it through RULINGS or FIXES there: a re-import rewrites this file.
source: cases/scarpe_examples/legacy/for_playtest/shoes-contrib/basic/shoes-notes.sspec
source_commit: 1e766c6
display: any
expect: fail
reason: Lacci makes title, subtitle, banner and caption Para subclasses (element.title),
  so paras() still includes them, and the finders go by size, so restyling the size
  loses the banner
----------- app code
Shoes.app do
  stack :margin => 20, :width => 250 do
    subtitle "Shoes Notebook"
    para "Add a note."
    @add = edit_line

    button "Save" do
      @notes.append do
        para @add.text, " ",
          link("delete") { |x| x.parent.remove }
      end
      @add.text = ""
    end
  end
  @notes = stack :margin => 20, :width => -250
end
----------- test code
# Notebook app with Save button and note management
s = subtitles().first
assert s, "Should have subtitle"
assert_includes s.text, "Shoes Notebook"
p = paras().first
assert p, "Should have para"
assert_includes p.text, "Add a note."
assert_equal "Save", buttons().first.text
