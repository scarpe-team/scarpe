----------- test code
# Test the alert button demo
assert_equal "Click me!", button().text

# Stub alert() so clicking the button doesn't block
stub_dialog(:alert, nil)
button().trigger_click
# If we get here without blocking, the test passes!
assert true, "Alert was stubbed successfully"
