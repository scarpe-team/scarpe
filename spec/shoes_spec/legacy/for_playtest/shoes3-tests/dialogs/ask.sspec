----------- test code
# Verify button exists
assert_equal "ask", button().text

# Stub ask() to return a known value, then trigger the button
stub_dialog(:ask, "Very lucky!")
button().trigger_click

# The para should now contain our stubbed response
assert_equal "Very lucky!", para().text
