----------- app code
# no group radios
 Shoes.app do
   stack do
     para "Among these films, which do you prefer?"
     flow { radio; para "The Taste of Tea by Katsuhito Ishii" }
     flow { radio; para "Kin-Dza-Dza by Georgi Danelia" }
     flow { radio; para "Children of Heaven by Majid Majidi" }
   end
 end
----------- test code
# Test the no-group radio demo
all_paras = paras()
assert_equal "Among these films, which do you prefer?", all_paras[0].text
assert_equal "The Taste of Tea by Katsuhito Ishii", all_paras[1].text
assert_equal "Kin-Dza-Dza by Georgi Danelia", all_paras[2].text
assert_equal "Children of Heaven by Majid Majidi", all_paras[3].text
