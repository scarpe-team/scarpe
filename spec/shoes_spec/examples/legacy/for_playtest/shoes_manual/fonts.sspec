----------- app code
Shoes.app do
  para "てすと (te-su-to)", font: case RUBY_PLATFORM
  when /mingw/; "MS UI Gothic"
  when /darwin/; "AppleGothic, Arial"
  else "Arial"
  end
end
----------- test code
# Verify Japanese text paragraph with font setting
assert paras().length >= 1, "Expected a para element"
assert_includes para().text, "てすと"
