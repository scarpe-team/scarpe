----------- app code
Shoes.app do
  fill black(0.1)
  shape do
    100.times do |i|
      oval i, i, i * 2
    end
  end
end
----------- test code
# Verify shape with ovals is rendered
assert shape(), "Should have a shape container"
all_ovals = ovals()
assert_equal 100, all_ovals.count, "Should have 100 ovals inside shape"
