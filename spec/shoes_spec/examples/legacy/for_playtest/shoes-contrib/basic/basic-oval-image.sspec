----------- app code
Shoes.app do
  fill blue(0.1)
  image 300, 300 do
    300.times do |i|
      oval i, i, i * 2
    end
  end
end
----------- test code
# Verify image container and ovals exist
assert image(), "Should have an image container"
all_ovals = ovals()
assert_equal 300, all_ovals.count, "Should have 300 ovals inside image"
