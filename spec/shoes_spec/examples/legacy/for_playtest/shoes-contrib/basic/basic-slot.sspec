----------- test code
# Verify 60 paragraphs are created
all_paras = paras()
assert_equal 60, all_paras.count, "Should have exactly 60 paragraphs"

# Verify paragraph content pattern
assert_equal "Paragraph No. 0", all_paras[0].text
assert_equal "Paragraph No. 59", all_paras[59].text
