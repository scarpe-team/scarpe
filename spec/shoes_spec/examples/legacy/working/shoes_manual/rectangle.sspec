----------- app code
#!ruby
 Shoes.app do
   stroke rgb(0.5, 0.5, 0.7)
   fill rgb(1.0, 1.0, 0.9)
   rect 10, 10, self.width - 20, self.height - 20
 end
----------- test code
# Verify a rect shape was created
r = rect()
refute_nil r

# Verify rect position
assert_equal 10, r.left
assert_equal 10, r.top
