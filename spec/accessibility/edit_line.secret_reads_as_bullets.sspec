---
# ext-scarpe, ledger N1: Scarpe draws its own controls, so it tells a screen reader what they are.
testability: visual
display: native
ledger: N1
----------- app code
Shoes.app do
  @pin = edit_line "hunter2", secret: true
end
----------- test code
node = a11y_nodes.find { |n| n[:role] == "password_input" }
refute_nil node, "a secret field is a password field"
assert_equal "\u2022" * 7, node[:value]
refute_includes a11y_tree.inspect, "hunter2", "the secret is nowhere in the tree"
