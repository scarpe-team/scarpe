----------- app code
Shoes.app do
  para "Among these films, which do you prefer?\n"
  radio; para strong("The Taste of Tea"), " by Katsuhito Ishii\n"
  radio; para strong("Kin-Dza-Dza"), " by Georgi Danelia\n"
  radio; para strong("Children of Heaven"), " by Majid Majidi\n"
end
----------- test code
all = radios
assert_equal 3, all.size

all.each do |chosen|
  chosen.trigger_click
  assert_equal [chosen.linkable_id], all.select(&:checked?).map(&:linkable_id),
    "radios in one slot, even among paras, allow one mark at a time"
end
