---
manual: progress.animate_example
lines: [3248, 3259]
testability: visual
display: native
----------- app code
Shoes.app do
  stack margin: 0.1 do
    title "Progress example"
    @p = progress width: 1.0

    animate do |i|
      @p.fraction = (i % 100) / 100.0
    end
  end
end
----------- test code
slot = layout_of(stack)
bar = layout_of(progress)

assert_in_delta slot.x, bar.x, 0.5, "width: 1.0 starts the bar at the stack's left edge"
assert_in_delta slot.w, bar.w, 0.5, "and spans the stack's whole width"
assert_operator bar.w, :>, 200, "longer than the default bar"
