----------- test code
essay = "Essays, even!\nA second line."
refute_equal essay, edit_box.text

edit_box.trigger_change(essay)

assert_kind_of String, edit_box.text, "text returns a String, not the box (ledger M5)"
assert_equal essay, edit_box.text, "holding every character typed, line breaks included"
