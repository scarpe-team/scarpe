----------- test code
refute_equal "Essays, even!", edit_box.text

edit_box.text = "Essays, even!"
assert_equal "Essays, even!", edit_box.text, "text = fills the box with the string"

edit_box.text = "Shorter"
assert_equal "Shorter", edit_box.text, "replacing what was there"
