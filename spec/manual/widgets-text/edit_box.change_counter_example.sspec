---
manual: edit_box.change_counter_example
lines: [3021, 3033]
testability: interactive
display: any
ledger: F11
----------- app code
Shoes.app do
  edit_box do |e|
    @counter.text = e.text.size
  end
  @counter = strong("0")
  para @counter, " characters"
end
----------- test code
assert_equal "0 characters", para.text

edit_box.trigger_change("hello")
assert_equal "5 characters", para.text, "the change block keeps the count up to date"

edit_box.trigger_change("hello, Shoes")
assert_equal "12 characters", para.text
