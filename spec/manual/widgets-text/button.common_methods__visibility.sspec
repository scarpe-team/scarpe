manual: button.common_methods
lines: [2915, 2916]
testability: api
display: any
----------- app code
# hide, show and toggle (manual 2639-2642, 2686-2689, 2715-2717) on a button.
Shoes.app do
  stack { @ok = button "OK!" }
end
----------- test code
ok = button
refute ok.style[:hidden], "a new button is shown"

ok.hide
assert_equal true, ok.style[:hidden], "hide hides the button"

ok.show
assert_equal false, ok.style[:hidden], "show reveals it"

ok.toggle
assert_equal true, ok.style[:hidden], "toggle hides a shown button"

ok.toggle
assert_equal false, ok.style[:hidden], "toggle shows a hidden button"
