---
manual: list_box.focus
lines: [3221, 3224]
testability: visual
display: native
----------- app code
Shoes.app do
  @first = list_box items: ["Grapes", "Pears", "Apricots"], choose: "Grapes"
  @second = list_box items: ["Grapes", "Pears", "Apricots"], choose: "Grapes"
end
----------- test code
# Every other pixel in a band from 4 px outside the box to 4 px inside it, within the window.
edge_band = lambda do |r|
  pixels = []
  (r.x - 4).step(r.x + r.w + 4, 2) do |x|
    (r.y - 4).step(r.y + r.h + 4, 2) do |y|
      core = x > r.x + 4 && x < r.x + r.w - 4 && y > r.y + 4 && y < r.y + r.h - 4
      pixels << pixel_at(x, y) unless core || x < 0 || y < 0
    end
  end
  pixels
end

list_box("@first").focus
unfocused = edge_band.call(layout_of(list_box("@second")))

list_box("@second").focus
focused = edge_band.call(layout_of(list_box("@second")))

refute_equal unfocused, focused, "a focused list box is highlighted"
