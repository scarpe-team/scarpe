---
manual: art.patterns_images_gradients
lines: [1657, 1660]
testability: visual
display: native
ledger: D6
----------- app code
Shoes.app width: 200, height: 200 do
  fill gradient(red, blue)
  nostroke
  rect 50, 50, 100, 100
end
----------- test code
top_left = pixel_at(52, 52)
bottom_right = pixel_at(148, 148)

assert_operator top_left[0], :>, top_left[2] + 100, "a gradient fill starts red: #{top_left.inspect}"
assert_operator bottom_right[2], :>, bottom_right[0] + 100, "and ends blue: #{bottom_right.inspect}"
assert_equal [255, 255, 255], pixel_at(160, 100).first(3), "only the shape is filled"
