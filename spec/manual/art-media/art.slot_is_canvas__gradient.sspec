---
manual: art.slot_is_canvas
lines: [1625, 1626]
testability: visual
display: native
ledger: D6
----------- app code
Shoes.app width: 300, height: 200 do
  stack left: 100, top: 50, width: 100, height: 100 do
    background red..blue
  end
end
----------- test code
top_left = pixel_at(102, 52)
bottom_right = pixel_at(198, 148)

assert_operator top_left[0], :>, top_left[2] + 100, "the gradient starts red at the slot's top left: #{top_left.inspect}"
assert_operator bottom_right[2], :>, bottom_right[0] + 100, "and ends blue at its bottom right: #{bottom_right.inspect}"
assert_equal [255, 255, 255], pixel_at(210, 100).first(3), "the gradient covers the slot and no more"
