---
manual: art.shape.move_to
lines: [1799, 1804]
testability: visual
display: native
ledger: E7
----------- app code
Shoes.app width: 200, height: 200 do
  nofill
  stroke red
  strokewidth 6
  shape do
    move_to 50, 50
    line_to 150, 50
    move_to 50, 150
    line_to 150, 150
  end
end
----------- test code
paints = lambda do |x, y, expected, why|
  actual = pixel_at(x, y).first(3)
  close = expected.zip(actual).all? { |want, got| (want - got).abs <= 20 }
  assert close, "#{why}: wanted #{expected.inspect} at (#{x}, #{y}), got #{actual.inspect}"
end
red = [255, 0, 0]
white = [255, 255, 255]

paints.(100, 50, red, "the first segment is drawn")
paints.(100, 150, red, "so is the segment after the second move_to")
paints.(100, 100, white, "move_to moved the pen from (150, 50) to (50, 150) without drawing")
paints.(25, 25, white, "and the first move_to drew nothing either")
