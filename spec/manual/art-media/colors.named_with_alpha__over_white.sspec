---
manual: colors.named_with_alpha
lines: [1806, 1818]
testability: visual
display: native
ledger: D3
----------- app code
Shoes.app width: 200, height: 200 do
  fill red(0.2)
  nostroke
  rect 50, 50, 100, 100
end
----------- test code
paints = lambda do |x, y, expected, why|
  actual = pixel_at(x, y).first(3)
  close = expected.zip(actual).all? { |want, got| (want - got).abs <= 12 }
  assert close, "#{why}: wanted #{expected.inspect} at (#{x}, #{y}), got #{actual.inspect}"
end

paints.(100, 100, [255, 204, 204], "red(0.2) over white blends to a pale pink")
