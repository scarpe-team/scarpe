----------- app code
Shoes.app do
  $blue = blue
  $red = red
end
----------- test code
assert_kind_of Shoes::Color, $blue, "blue is a Color object"
assert_kind_of Shoes::Color, $red, "red is a Color object"
assert_equal 255, $blue.blue
assert_equal 255, $red.red
