---
manual: art.cap.rect_default
lines: [1679, 1680]
testability: visual
display: native
----------- app code
Shoes.app width: 300, height: 200 do
  stroke black
  strokewidth 20
  line 50, 100, 150, 100
end
----------- test code
paints = lambda do |x, y, expected, why|
  actual = pixel_at(x, y).first(3)
  close = expected.zip(actual).all? { |want, got| (want - got).abs <= 20 }
  assert close, "#{why}: wanted #{expected.inspect} at (#{x}, #{y}), got #{actual.inspect}"
end

paints.(148, 108, [0, 0, 0], "the line is full width right up to its end")
paints.(153, 100, [255, 255, 255], "by default the line ends abruptly flat at (150, 100)")
paints.(47, 100, [255, 255, 255], "at both ends")
