----------- app code
Shoes.app width: 400, height: 300 do
  @box = stack width: 100, height: 100 do
    background red
  end
end
----------- test code
assert_equal [255, 0, 0, 255], pixel_at(50, 50)

stack("@box").hide

refute_equal [255, 0, 0, 255], pixel_at(50, 50), "a hidden slot cannot be seen"
