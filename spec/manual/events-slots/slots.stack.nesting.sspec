---
manual: slots.stack.nesting
lines: [1605, 1606]
testability: api
display: any
----------- app code
Shoes.app do
  $outer = stack do
    $inner_stack = stack { para "stacked" }
    $inner_flow = flow { para "flowed" }
  end
end
----------- test code
assert_equal [$inner_stack, $inner_flow], $outer.contents, "a stack holds a stack and a flow"
assert_same $outer, $inner_stack.parent
assert_same $outer, $inner_flow.parent
assert_equal ["stacked"], $inner_stack.contents.map(&:text), "the nested slots keep their own children"
assert_equal ["flowed"], $inner_flow.contents.map(&:text)
