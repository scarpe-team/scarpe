---
manual: events.click
lines: [2187, 2193]
testability: interactive
display: native
ledger: E8
----------- app code
# An empty slot laid over a clickable one lets a press through, and a test's click_on goes
# where a real press would: it is refused only when something on top would take the press.
$taps = 0
Shoes.app width: 240, height: 130 do
  @box = stack(left: 20, top: 20, width: 90, height: 90) do
    background "#e53935"
    para "Tap me", stroke: white, margin: [14, 34, 0, 0]
  end
  @box.click { $taps += 1 }
  @layer = stack(left: 0, top: 0, width: 240, height: 130) {}
end
----------- test code
click_on stack("@box")
assert_equal 1, $taps, "click_on reaches the box through the empty layer"
click_on "Tap me"
assert_equal 2, $taps, "and so does its label"
click_at 60, 60
assert_equal 3, $taps, "as a press at the same point does"
