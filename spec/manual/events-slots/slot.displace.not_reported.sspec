----------- app code
Shoes.app do
  $slot = stack left: 30, top: 40, width: 50, height: 50
end
----------- test code
assert_equal [30, 40], [$slot.left, $slot.top]

$slot.displace(5, 6)

assert_equal [30, 40], [$slot.left, $slot.top], "left and top do not report displacement"
