---
manual: slots.flow.adjacent_text_one_paragraph
lines: [1611, 1612]
testability: visual
display: native
ledger: C7
expect: fail
reason: "The native layout still boxes each para on its own, so the long one starts a new row; C7 was ruled for one paragraph on 27 Sep 2026 (Q2) and the layout lane is landing it"
----------- app code
# margin: 0 keeps the default text margins (ledger C9) out of the paragraph question.
Shoes.app width: 400, height: 300 do
  @flow = flow width: 300 do
    @short = para "Short.", margin: 0
    @long = para "This second paragraph is long enough that it has to wrap onto more lines inside three hundred pixels.", margin: 0
  end
end
----------- test code
flow_box = layout_of(flow("@flow"))
short = layout_of(para("@short"))
long = layout_of(para("@long"))

assert_operator long.h, :>, short.h * 1.5, "the long para needs more than one line"
assert_in_delta short.y, long.y, 0.5, "it carries on from the end of the short one, on the same line"
assert_in_delta flow_box.x, long.x, 0.5, "and its later lines wrap back to the flow's left edge, as one paragraph would"
