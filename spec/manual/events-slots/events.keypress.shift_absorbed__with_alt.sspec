----------- app code
$keys = []
Shoes.app do
  keypress { |key| $keys << key }
end
----------- test code
press_key :shift_alt_7
assert_equal [:"alt_&"], $keys, "Shift-Alt-7 folds the shift into the character: :alt_&"
