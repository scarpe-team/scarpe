----------- app code
Shoes.app do
  $slot = stack width: 50, height: 50
end
----------- test code
$slot.displace(5, -6)
assert_equal 5, $slot.style[:displace_left], "displace is a shortcut for :displace_left"
assert_equal(-6, $slot.style[:displace_top], "and :displace_top, negative numbers included")
