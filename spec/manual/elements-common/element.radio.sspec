manual: element.radio
lines: [2069, 2071]
testability: api
display: any
----------- app code
Shoes.app do
  para "Among these films, which do you prefer?\n"
  $taste = radio; para strong("The Taste of Tea"), " by Katsuhito Ishii\n"
  radio; para strong("Kin-Dza-Dza"), " by Georgi Danelia\n"
  radio; para strong("Children of Heaven"), " by Majid Majidi\n"
end
----------- test code
assert_instance_of Shoes::Radio, $taste, "radio returns a Shoes::Radio"
assert_equal 3, radios.size, "each call adds a radio button"
