----------- app code
Shoes.app title: "The Owner" do
  button "Pop up?" do
    $popup = window do
      para "Okay, popped up from #{owner}"
    end
  end
end
----------- test code
find_button("Pop up?").trigger_click

assert_instance_of Shoes::App, $popup, "window returns a Shoes::App"
assert_same Shoes.APPS.last, $popup, "the app it opened"
