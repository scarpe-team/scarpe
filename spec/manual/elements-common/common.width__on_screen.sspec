---
manual: common.width
lines: [2730, 2732]
testability: visual
display: native
ledger: C2
----------- app code
Shoes.app do
  stack width: 120 do
    @b = button "Click me", width: "100%" do
      alert "button.width = #{@b.width}\n" +
        "button.style[:width] = #{@b.style[:width]}"
    end
  end
end
----------- test code
assert_in_delta 120, layout_of(button("@b")).w, 0.5, "the 100% button is drawn 120 pixels wide"
assert_equal 120, button("@b").width, "and width says so"
