---
manual: element.tagline.size
lines: [2107, 2110]
testability: visual
display: native
ledger: F2
----------- app code
Shoes.app do
  flow { @default = tagline "Shoes" }
  flow { @sized = para "Shoes", size: 18 }
  flow { @double = para "Shoes", size: 36 }
end
----------- test code
default = layout_of(drawable("@default"))
sized = layout_of(drawable("@sized"))
double = layout_of(drawable("@double"))

assert_operator double.w, :>, sized.w * 1.5, "the size style changes how big text is drawn"
assert_in_delta sized.w, default.w, 0.5, "tagline text is as wide as 18 pixel text"
assert_in_delta sized.h, default.h, 0.5, "and as high"
