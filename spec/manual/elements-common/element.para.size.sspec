---
manual: element.para.size
lines: [2064, 2067]
testability: visual
display: native
ledger: F2
----------- app code
Shoes.app do
  flow { @default = para "Shoes" }
  flow { @sized = para "Shoes", size: 12 }
  flow { @double = para "Shoes", size: 24 }
end
----------- test code
default = layout_of(drawable("@default"))
sized = layout_of(drawable("@sized"))
double = layout_of(drawable("@double"))

assert_operator double.w, :>, sized.w * 1.5, "the size style changes how big text is drawn"
assert_in_delta sized.w, default.w, 0.5, "para text is as wide as 12 pixel text"
assert_in_delta sized.h, default.h, 0.5, "and as high"
