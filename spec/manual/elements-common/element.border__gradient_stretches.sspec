---
manual: element.border
lines: [1927, 1929]
testability: visual
display: native
ledger: D6
----------- app code
Shoes.app do
  @box = stack width: 100, height: 300 do
    border gradient(red, blue), strokewidth: 10
  end
end
----------- test code
px = ->(x, y) { pixel_at(x.round, y.round).first(3) }

box = layout_of(stack("@box"))
reds = (0..10).map { |i| px.(box.x + 4, box.y + 2 + i * 29.6).first }

assert_operator reds.first, :>, 220, "red at the top of the left edge"
assert_operator reds.last, :<, 35, "blue at the bottom"
assert reds.each_cons(2).all? { |upper, lower| lower <= upper + 2 }, "one ramp over the whole border: #{reds.inspect}"
