----------- app code
Shoes.app do
  stack margin: 10 do
    para "Pick a card:"
    $cards = list_box items: ["Jack", "Ace", "Joker"]
  end
end
----------- test code
assert_instance_of Shoes::ListBox, $cards, "list_box returns a Shoes::ListBox"
assert_equal ["Jack", "Ace", "Joker"], list_box.items, "one entry for everything in items"
