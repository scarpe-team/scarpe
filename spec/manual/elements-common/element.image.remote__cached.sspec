---
manual: element.image.remote
lines: [2011, 2013]
testability: visual
display: native
----------- app code
# A web server on this machine only, so the case needs no network.
require "socket"
png = File.binread("assets/red-40x30.png")
server = TCPServer.new("127.0.0.1", 0)
$url = "http://127.0.0.1:#{server.addr[1]}/red-40x30.png"
$requests = 0
Thread.new do
  loop do
    client = server.accept
    nil while (line = client.gets) && line != "\r\n"
    $requests += 1
    client.write "HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: #{png.bytesize}\r\nConnection: close\r\n\r\n"
    client.write png
    client.close
  end
end
Shoes.app do
  @first = image $url
  @second = image $url
end
----------- test code
px = ->(x, y) { pixel_at(x.round, y.round).first(3) }
near = ->(expected, actual, tolerance = 24) { expected.zip(actual).all? { |e, a| (e - a).abs <= tolerance } }

shown = lambda do |name|
  picture = layout_of(image(name))
  near.([255, 0, 0], px.(picture.x + 20, picture.y + 15), 4)
end
40.times { %w[@first @second].all?(&shown) ? break : advance(0.1) } # remote images load in the background

assert shown.("@first"), "the first image shows"
assert shown.("@second"), "and so does the second"
assert_equal 1, $requests, "the second image comes from the cache, not a second download"
