----------- app code
Shoes.app do
  stack margin: 10 do
    para "Pick a card:"
    list_box items: ["Jack", "Ace", "Joker"]
  end
end
----------- test code
refute_equal "Ace", list_box.text, "Ace is not selected yet"

list_box.trigger_change("Ace")

assert_equal "Ace", list_box.text, "text is the selected string"
