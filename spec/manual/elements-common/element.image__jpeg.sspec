Shoes.app do
  para "Nice, nice, very nice.  Busy, busy, busy."
  @picture = image "red-40x30.jpeg"
end
----------- test code
px = ->(x, y) { pixel_at(x.round, y.round).first(3) }
near = ->(expected, actual, tolerance = 24) { expected.zip(actual).all? { |e, a| (e - a).abs <= tolerance } }

picture = layout_of(image("@picture"))

assert_equal [40, 30], [picture.w.round, picture.h.round], "the JPEG shows at its own size"
assert near.([255, 0, 0], px.(picture.x + 20, picture.y + 15), 4), "and shows its red pixels"
