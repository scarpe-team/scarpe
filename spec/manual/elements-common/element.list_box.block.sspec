---
manual: element.list_box.block
lines: [3186, 3197]
testability: interactive
display: any
ledger: G2
----------- app code
Shoes.app do
  para "Choose a fruit:"
  list_box items: ["Grapes", "Pears", "Apricots"],
    width: 120, choose: "Apricots" do |list|
      @fruit.text = list.text
  end

  @fruit = para "No fruit selected"
end
----------- test code
assert_equal "No fruit selected", para("@fruit").text, "the block waits for a selection"

list_box.trigger_change("Pears")

assert_equal "Pears", para("@fruit").text, "selecting an item runs the block"
