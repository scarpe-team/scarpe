----------- app code
# Not the manual's version: inside app { } self is the App, so @stack would be the App's
# (nil) ivar. Hold the stack in a local first (B2, M39).
class Messenger
  def initialize(stack)
    @stack = stack
  end
  def add(msg)
    stack = @stack
    @stack.app do
      stack.append do
        para msg
      end
    end
  end
end

Shoes.app do
  @log = stack { para "Welcome" }
  $messenger = Messenger.new(@log)
end
----------- test code
$messenger.add("A message came in")

assert_equal ["Welcome", "A message came in"], stack.contents.map(&:text),
  "app { } reopens the App, so para works again from a plain object"
