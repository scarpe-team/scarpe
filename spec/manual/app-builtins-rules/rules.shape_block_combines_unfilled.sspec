ledger: M21
----------- app code
Shoes.app do
  fill black(0.1)
  shape do
    100.times do |i|
      oval i, i, i * 2
    end
  end
end
----------- test code
assert_equal 1, shapes.size, "the ovals are combined into a single shape"
top_slot = Shoes.APPS.first.document_root.contents
assert_equal [shape.linkable_id], top_slot.map(&:linkable_id), "no oval stands on its own in the window"
