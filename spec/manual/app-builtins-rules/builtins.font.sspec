----------- app code
# Both fonts ship with Scarpe; Shoes::Constants::DIR is the checkout.
FIRA_MONO = File.join(Shoes::Constants::DIR, "native", "assets", "fonts", "FiraMono-Medium.ttf")
PACIFICO = File.join(Shoes::Constants::DIR, "fonts", "Pacifico.ttf")

Shoes.app do
  font FIRA_MONO
  $families = font(PACIFICO)
end
----------- test code
assert File.exist?(PACIFICO), "the test font is at #{PACIFICO}"
assert_equal ["Pacifico"], $families, "font returns the family names found in the file, and only those"
