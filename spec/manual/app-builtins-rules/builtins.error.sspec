----------- app code
Shoes.app do
  button "Fail" do
    $returned = :not_called
    $returned = error("The sprockets are jammed")
  end
end
----------- test code
out, err = capture_io { find_button("Fail").trigger_click }

assert_includes out + err, "The sprockets are jammed", "the error reaches the console"
assert_nil $returned, "error returns nil"
