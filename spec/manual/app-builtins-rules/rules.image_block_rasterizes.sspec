---
manual: rules.image_block_rasterizes
lines: [410, 426]
testability: visual
display: any
ledger: E9
----------- app code
Shoes.app do
  fill black(0.1)
  image 300, 300 do
    100.times do |i|
      oval i, i, i * 2
    end
  end
end
----------- test code
assert_equal 1, images.size, "the image block makes one image"
assert_equal [300, 300], [image.width, image.height], "300 x 300 pixels"
assert_empty ovals.reject { |shape| shape.parent.is_a?(Shoes::Image) },
  "no oval stands on its own in the window"
