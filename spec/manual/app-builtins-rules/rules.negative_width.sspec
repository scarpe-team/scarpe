---
manual: rules.negative_width
lines: [337, 339]
testability: visual
display: any
ledger: A4
----------- app code
Shoes.app width: 600, height: 500 do
  flow do
    @one = stack width: 200 do
      para "is 200 pixels wide"
    end
    @two = stack width: -200 do
      para "is 100% minus 200 pixels wide"
    end
  end
end
----------- test code
assert_equal 600, Shoes.APPS.first.width, "the window this case assumes"
assert_equal 400, stack("@two").width, "width: -200 is the whole parent width minus 200 pixels"
