----------- app code
Shoes.app do
  $finished = Queue.new
  stack do
    title "POST Google", size: 16
    @status = para "One moment..."

    button "Send" do
      download "http://shoes.invalid/search?q=shoes",
          method: "POST" do |dump|
        @status.text = dump.response.body
        $finished << :done
      end
    end
  end
end
----------- test code
require "net/http"

# A fake web: Net::HTTP never opens a socket, and every request gets this answer.
$requests = []
Net::HTTP.prepend(Module.new do
  def connect; end

  def request(req, body = nil)
    $requests << { method: req.method, headers: req.to_hash, body: req.body || body }
    $gate&.pop(timeout: 5)
    Net::HTTPOK.new("1.1", "200", "OK").tap do |res|
      res["Content-Type"] = "text/plain"
      res["X-Shoes"] = "Curious"
      res.instance_variable_set(:@body, "Hello from the fake web")
      res.instance_variable_set(:@read, true)
    end
  end
end)

find_button("Send").trigger_click

assert_equal :done, $finished.pop(timeout: 10), "the finish block ran"
assert_equal "POST", $requests.last[:method], "the :method style sets the HTTP method"
assert_equal "Hello from the fake web", para("@status").text
