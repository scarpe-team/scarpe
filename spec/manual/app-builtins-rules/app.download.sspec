----------- app code
Shoes.app do
  $finished = Queue.new
  stack do
    title "Searching Google", size: 16
    @status = para "One moment..."

    button "Search" do
      # Search for 'shoes' and print the HTTP headers
      download "http://shoes.invalid/search?q=shoes" do |goog|
        @status.text = "Headers: " + goog.response.headers.inspect
        $finished << goog
      end
    end
  end
end
----------- test code
require "net/http"

# A fake web: Net::HTTP never opens a socket, and every request gets this answer.
$requests = []
Net::HTTP.prepend(Module.new do
  def connect; end

  def request(req, body = nil)
    $requests << { method: req.method, headers: req.to_hash, body: req.body || body }
    $gate&.pop(timeout: 5)
    Net::HTTPOK.new("1.1", "200", "OK").tap do |res|
      res["Content-Type"] = "text/plain"
      res["X-Shoes"] = "Curious"
      res.instance_variable_set(:@body, "Hello from the fake web")
      res.instance_variable_set(:@read, true)
    end
  end
end)

$gate = Queue.new
find_button("Search").trigger_click

assert $finished.empty?, "download returns at once and runs the transfer in the background"
assert_equal "One moment...", para("@status").text

$gate << :let_the_answer_through
goog = $finished.pop(timeout: 10)

refute_nil goog, "the attached block runs as the finish event, given the download"
assert_match(/\AHeaders: /, para("@status").text)
