----------- app code
# Pacifico ships with Scarpe (fonts/Pacifico.ttf); Shoes::Constants::DIR is the checkout.
PACIFICO = File.join(Shoes::Constants::DIR, "fonts", "Pacifico.ttf")

Shoes.app do
  $listed_before = Shoes::FONTS.include?("Pacifico")
  font PACIFICO
end
----------- test code
assert File.exist?(PACIFICO), "the test font is at #{PACIFICO}"
refute $listed_before, "Pacifico is not a font the system already had"
assert_includes Shoes::FONTS, "Pacifico", "a font loaded with font() joins Shoes::FONTS"
