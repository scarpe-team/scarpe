----------- test code
# A stand-in system clipboard in this sandbox, so the case never touches the real one.
# Other programs (pbcopy/pbpaste, xclip) read and write it through a file.
board = File.expand_path("system-clipboard.txt")
Dir.mkdir("fakeclip")
File.write("fakeclip/pbcopy", "#!/bin/sh\ncat > '#{board}'\n")
File.write("fakeclip/pbpaste", "#!/bin/sh\ncat '#{board}'\n")
File.write("fakeclip/xclip", "#!/bin/sh\nfor arg; do [ \"$arg\" = -o ] && exec cat '#{board}'; done\ncat > '#{board}'\n")
Dir["fakeclip/*"].each { |tool| File.chmod(0o755, tool) }
ENV["PATH"] = "#{File.expand_path("fakeclip")}:#{ENV["PATH"]}"
File.write(board, "old contents")

find_button("Copy").trigger_click

assert_equal "Shoes was here", File.read(board), "other programs see the text on the system clipboard"
