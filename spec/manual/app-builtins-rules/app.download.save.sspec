----------- app code
Shoes.app do
  $finished = Queue.new
  stack do
    title "Downloading Google image", size: 16
    @status = para "One moment..."

    button "Fetch" do
      download "http://shoes.invalid/logos/nasa50th.gif",
        save: "nasa50th.gif" do |dl|
          @status.text = "Okay, is downloaded."
          $finished << [:finished, dl]
      end
    end
  end
end
----------- test code
require "net/http"

# A fake web: Net::HTTP never opens a socket, and every request gets this answer.
$requests = []
Net::HTTP.prepend(Module.new do
  def connect; end

  def request(req, body = nil)
    $requests << { method: req.method, headers: req.to_hash, body: req.body || body }
    $gate&.pop(timeout: 5)
    Net::HTTPOK.new("1.1", "200", "OK").tap do |res|
      res["Content-Type"] = "text/plain"
      res["X-Shoes"] = "Curious"
      res.instance_variable_set(:@body, "Hello from the fake web")
      res.instance_variable_set(:@read, true)
    end
  end
end)

find_button("Fetch").trigger_click
event, dl = $finished.pop(timeout: 10)

assert_equal :finished, event, "the finish block ran"
assert_equal "Hello from the fake web", File.read("nasa50th.gif"), "save: writes the data to that file"
assert_equal "Okay, is downloaded.", para("@status").text
refute_nil dl, "the finish block is still given the download"
assert_nil dl.response.body, "the data went to the file, not to memory"
refute_empty dl.response.headers, "the headers are still there"
