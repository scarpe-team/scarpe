---
manual: builtins.ask.secret
lines: [1385, 1391]
testability: dialog
display: any
ledger: K1
----------- app code
Shoes.app do
  button "Log in" do
    $password = ask("Password?", secret: true)
  end
end
----------- test code
stub_dialog(:ask, "hunter2")
find_button("Log in").trigger_click

assert_equal "hunter2", $password, "a secret ask still returns what was typed"
kind, message, *options = dialog_calls.last
assert_equal [:ask, "Password?"], [kind, message]
assert options.any? { |option| option.is_a?(Hash) && (option[:secret] || option["secret"]) },
  "the dialog is told to mask what is typed, got #{options.inspect}"
