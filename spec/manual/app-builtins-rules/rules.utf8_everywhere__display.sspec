----------- app code
Shoes.app do
  @words = para "Ελληνικά, Русский, Español"
end
----------- test code
node = layout_tree.find { |entry| entry[:id] == para("@words").linkable_id }
refute_nil node, "the para was laid out"
assert_equal "Ελληνικά, Русский, Español", node[:text], "the display received and shows the text intact"
assert_operator node[:w], :>, 100, "and set it at a real width"
