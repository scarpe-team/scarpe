----------- app code
Shoes.app do
  url "/", :index
  url "/about", :about

  def index
    button("About") { visit "/about" }
  end

  def about
    para "Made with Shoes"
  end
end
----------- test code
app = Shoes.APPS.first
assert_equal "/", app.location, "location is the URL of the page on show"

find_button("About").trigger_click

assert_equal "/about", app.location, "and follows visit"
assert_kind_of String, app.location
