---
manual: styles.underline.error
lines: [1505, 1509]
testability: visual
display: native
----------- app code
Shoes.app width: 400, height: 300 do
  flow(margin_bottom: 20) { @straight = para "H     H", underline: "single", size: 30 }
  flow(margin_bottom: 20) { @wavy = para "H     H", underline: "error", size: 30 }
end
----------- test code
# The gap between the two H's holds no letters, so any ink in it is a line drawn across the text.
# Lines may hang a little below the line box, so look 10 pixels past it (neighbours sit 20 below).
gap_runs = lambda do |name|
  box = layout_of(para(name))
  x = (box.x + box.w / 2).round
  rows = (box.y.floor...(box.y + box.h + 10).ceil).select { |y| pixel_at(x, y).first(3).sum < 600 }
  runs = rows.slice_when { |a, b| b != a + 1 }.to_a
  runs.map { |run| (run.first + run.last) / 2.0 - box.y }
end

heights = lambda do |name|
  (-6..6).map do |dx|
    box = layout_of(para(name))
    x = (box.x + box.w / 2 + dx).round
    rows = (box.y.floor...(box.y + box.h + 10).ceil).select { |y| pixel_at(x, y).first(3).sum < 600 }
    rows.sum.to_f / rows.size
  end
end
straight = heights.call("@straight")
wavy = heights.call("@wavy")
assert_operator straight.max - straight.min, :<=, 0.5, "a single underline is straight across the gap"
assert_operator wavy.max - wavy.min, :>=, 1, "underline: \"error\" goes up and down: it is wavy"
