----------- app code
Shoes.app do
  %w[none single double low error].each { |kind| instance_variable_set("@#{kind}", para(kind, underline: kind)) }
end
----------- test code
%w[none single double low error].each do |kind|
  assert_equal kind, para("@#{kind}").style[:underline], "underline: #{kind.inspect} is accepted and kept"
end
