----------- app code
Shoes.app width: 500, height: 300 do
  flow { @plain = para "Weight Watchers", size: 20 }
  flow { @bold = para "Weight Watchers", weight: "bold", size: 20 }
end
----------- test code
assert_operator layout_of(para("@bold")).w, :>, layout_of(para("@plain")).w + 2, "weight: \"bold\" sets heavier, wider letters"
