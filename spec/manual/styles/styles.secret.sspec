---
manual: styles.secret
lines: [1385, 1391]
testability: visual
display: native
----------- app code
Shoes.app width: 400, height: 200 do
  @thin = edit_line text: "iiiiii", secret: true
  @wide = edit_line text: "WWWWWW", secret: true
end
----------- test code
ink_width = lambda do |name|
  box = layout_of(edit_line(name))
  rows = ((box.y + 6).round..(box.y + box.h - 6).round).step(2).to_a
  xs = ((box.x + 4).round...(box.x + box.w - 4).round).select { |x| rows.any? { |y| pixel_at(x, y).first(3).sum < 384 } }
  xs.empty? ? 0 : xs.last - xs.first
end
thin = ink_width.call("@thin")
wide = ink_width.call("@wide")

assert_equal "WWWWWW", edit_line("@wide").text, "the real text is kept"
assert_operator thin, :>, 10, "something is shown for the six hidden letters"
assert_in_delta thin, wide, 1, "six replacement characters look the same whatever the letters were"
