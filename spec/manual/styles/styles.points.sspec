manual: styles.points
lines: [1341, 1346]
testability: visual
display: native
ledger: E4
----------- app code
Shoes.app width: 300, height: 300 do
  fill black
  stroke black
  @star = star 150, 150, points: 5, outer: 50, inner: 20
end
----------- test code
dark = ->(x, y) { pixel_at(x.round, y.round).first(3).sum < 200 }
ring = lambda do |radius, samples|
  (0...samples).map do |i|
    angle = 2 * Math::PI * i / samples
    dark.call(150 + radius * Math.cos(angle), 150 + radius * Math.sin(angle))
  end
end

around = ring.call(35, 360)
tips = around.each_index.count { |i| around[i] && !around[i - 1] }
assert_equal 5, tips, "points: 5 gives five separate points on a circle between the two radii"
