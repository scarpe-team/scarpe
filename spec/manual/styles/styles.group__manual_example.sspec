---
manual: styles.group
lines: [3310, 3334]
testability: interactive
display: any
ledger: G6
----------- app code
Shoes.app do
  stack do
    para "Among these films, which do you prefer?"
    flow do
      @tea = radio :films
      para "The Taste of Tea by Katsuhito Ishii"
    end
    flow do
      @kin = radio :films
      para "Kin-Dza-Dza by Georgi Danelia"
    end
    flow do
      @heaven = radio :films
      para "Children of Heaven by Majid Majidi"
    end
  end
end
----------- test code
tea = radio("@tea")
heaven = radio("@heaven")

tea.trigger_click
heaven.trigger_click

assert heaven.checked?, "the last radio clicked is marked"
refute tea.checked?, "the :films group spans the three flows"
refute radio("@kin").checked?, "the untouched radio stays unmarked"
