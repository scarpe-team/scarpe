---
manual: styles.stretch.normal
lines: [1428, 1433]
testability: visual
display: native
ledger: F5
expect: fail
reason: "Para does not declare :stretch, so Lacci drops it before it reaches the display (see styles.stretch__accepted)."
----------- app code
Shoes.app width: 500, height: 300 do
  flow { @plain = para "Stretching the letters", size: 20 }
  flow { @text = para "Stretching the letters", stretch: "condensed", size: 20 }
end
----------- test code
width = ->(name) { layout_of(para(name)).w }
assert_operator width.call("@text"), :<, width.call("@plain") - 5, "the paragraph starts condensed"

para("@text").style(stretch: "normal")
wait_frames

assert_in_delta width.call("@plain"), width.call("@text"), 0.5, "stretch: \"normal\" gives the standard width of letters back"
