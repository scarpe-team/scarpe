---
manual: styles.group
lines: [1226, 1237]
testability: interactive
display: any
ledger: G6
----------- app code
Shoes.app do
  stack do
    para "Among these films, which do you prefer?"
    flow do
      @tea = radio group: "films"
      para "The Taste of Tea by Katsuhito Ishii"
    end
    flow do
      @kin = radio group: "films"
      para "Kin-Dza-Dza by Georgi Danelia"
    end
  end
end
----------- test code
tea = radio("@tea")
kin = radio("@kin")

tea.trigger_click
assert tea.checked?, "the first radio is marked"

kin.trigger_click
assert kin.checked?, "the second radio is marked"
refute tea.checked?, "radios sharing a group name are exclusive although they sit in different slots"
