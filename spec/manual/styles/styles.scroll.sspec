---
manual: styles.scroll
lines: [1375, 1381]
testability: visual
display: native
----------- app code
Shoes.app width: 460, height: 300 do
  flow do
    @long = stack width: 200, height: 200, scroll: true do
      background "#DFA"
      100.times do |i|
        para "Paragraph No. #{i}"
      end
    end
    @short = stack width: 200, height: 200, scroll: true do
      background "#DFA"
      para "Paragraph No. 0"
    end
  end
end
----------- test code
# Any pixel in the slot's right-hand 12 columns that is not the slot's own background belongs to a scrollbar.
bar_pixels = lambda do |name|
  box = layout_of(stack(name))
  ground = pixel_at((box.x + 150).round, (box.y + box.h - 4).round).first(3)
  xs = ((box.x + box.w - 12).round...(box.x + box.w).round).to_a
  ys = ((box.y + 1).round...(box.y + box.h - 1).round).step(3).to_a
  ys.flat_map { |y| xs.map { |x| pixel_at(x, y).first(3) } }.reject { |px| px.zip(ground).all? { |a, b| (a - b).abs <= 6 } }
end
refute_empty bar_pixels.call("@long"), "content taller than the slot brings up a scrollbar inside its right edge"
assert_empty bar_pixels.call("@short"), "a scrolling slot whose content fits shows no scrollbar"
