---
manual: styles.size.large
lines: [1400, 1408]
testability: visual
display: native
ledger: F3
----------- app code
Shoes.app width: 600, height: 200 do
  flow { @present = para "HHHHHHHHHHHHHHHHHHHH" }
  flow { @sized = para "HHHHHHHHHHHHHHHHHHHH", size: "large" }
end
----------- test code
ratio = layout_of(para("@sized")).w / layout_of(para("@present")).w
assert_in_delta 1.2, ratio, 0.02, "size: \"large\" is 120% of the present size"
