---
manual: styles.displace_top
lines: [1171, 1179]
testability: visual
display: native
ledger: M9
----------- app code
Shoes.app width: 300, height: 200 do
  @column = stack width: 100 do
    @moved = stack width: 40, height: 30, displace_top: 20 do
      background red
    end
    @below = stack width: 40, height: 30 do
      background blue
    end
  end
end
----------- test code
column = layout_of(stack("@column"))
below = layout_of(stack("@below"))
x = (column.x + 20).round
red = ->(y) { r, g, b, = pixel_at(x, y.round); r > 200 && g < 60 && b < 60 }

assert_in_delta column.y + 30, below.y, 0.5, "the next element keeps its place: displacing does not change the layout"
refute red.call(column.y + 10), "the red block has left its laid-out spot"
assert red.call(column.y + 25), "it is drawn 20 pixels lower"
