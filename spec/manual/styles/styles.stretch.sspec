---
manual: styles.stretch
lines: [1423, 1434]
testability: visual
display: native
ledger: F5
expect: fail
reason: "Para does not declare :stretch, so Lacci drops it before it reaches the display (see styles.stretch__accepted)."
----------- app code
Shoes.app width: 500, height: 300 do
  flow { @condensed = para "Stretching the letters", stretch: "condensed", size: 20 }
  flow { @normal = para "Stretching the letters", stretch: "normal", size: 20 }
  flow { @expanded = para "Stretching the letters", stretch: "expanded", size: 20 }
end
----------- test code
condensed, normal, expanded = %w[@condensed @normal @expanded].map { |name| layout_of(para(name)).w }
assert_operator condensed, :<, normal - 5, "condensed is narrower than normal"
assert_operator expanded, :>, normal + 5, "expanded is wider than normal"
