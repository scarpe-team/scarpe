---
manual: styles.right.offset
lines: [1360, 1364]
testability: visual
display: native
ledger: C10
----------- app code
Shoes.app width: 400, height: 300 do
  @slot = stack margin_left: 20, width: 300, height: 200 do
    @edge = stack width: 50, height: 30, right: 20 do
      background red
    end
  end
end
----------- test code
slot = layout_of(stack("@slot"))
edge = layout_of(stack("@edge"))
assert_in_delta slot.x + slot.w - 20, edge.x + edge.w, 0.5, "right: 20 puts the right edge 20 pixels in from the slot's right edge"
