---
manual: styles.emphasis.normal
lines: [1186, 1190]
testability: visual
display: native
----------- app code
Shoes.app width: 300, height: 200 do
  flow { @text = para "I", emphasis: "italic", size: 80 }
end
----------- test code
box = layout_of(para("@text"))
starts = lambda do |fraction|
  y = (box.y + box.h * fraction).round
  ([box.x - 10, 0].max.floor...(box.x + box.w + 20).ceil).find { |x| pixel_at(x, y).first(3).sum < 384 }
end
lean = -> { starts.call(0.3) - starts.call(0.7) }
assert_operator lean.call, :>=, 4, "the paragraph starts out italic"

para("@text").emphasis = "normal"
wait_frames
box = layout_of(para("@text"))

assert_in_delta 0, lean.call, 1, "emphasis: \"normal\" stands the stem upright again"
