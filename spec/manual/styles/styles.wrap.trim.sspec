---
manual: styles.wrap.trim
lines: [1552, 1556]
testability: visual
display: native
----------- app code
Shoes.app width: 500, height: 300 do
  flow { @word = para "HHHHHH", size: 20 }
  @box = stack width: 400 do
    @text = para "HHHHHHHHHHHHHHHHHHHHHHHH", wrap: "trim", size: 20
  end
end
----------- test code
word = layout_of(para("@word"))
stack("@box").style(width: (word.w * 1.5).round)
wait_frames
text = layout_of(para("@text"))
line = (text.y.floor...(text.y + word.h).ceil).to_a
ink_rows = ->(x) { line.select { |y| pixel_at(x, y).first(3).sum < 384 } }

assert_in_delta word.h, text.h, 0.5, "trimmed text stays on one line"

past_the_edge = ((text.x + text.w).ceil...(text.x + text.w + 30).ceil).reject { |x| ink_rows.call(x).empty? }
assert_empty past_the_edge, "the overlong line is cut off at the paragraph's right edge"

tail = ((text.x + text.w - 20).floor...(text.x + text.w).ceil).map { |x| ink_rows.call(x) }.reject(&:empty?)
dots = tail.select { |rows| rows.max - rows.min <= 4 && rows.min > text.y + word.h / 2 }
refute_empty dots, "the line ends in an ellipsis: short marks sitting low, not full-height letters"
