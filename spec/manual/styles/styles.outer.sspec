---
manual: styles.outer
lines: [1335, 1339]
testability: visual
display: native
ledger: E4
----------- app code
Shoes.app width: 300, height: 300 do
  fill black
  stroke black
  @star = star 150, 150, points: 5, outer: 50, inner: 20
end
----------- test code
dark = ->(x, y) { pixel_at(x.round, y.round).first(3).sum < 200 }
ring = lambda do |radius, samples|
  (0...samples).map do |i|
    angle = 2 * Math::PI * i / samples
    dark.call(150 + radius * Math.cos(angle), 150 + radius * Math.sin(angle))
  end
end

assert ring.call(45, 360).any?, "the points reach past 45 pixels from the centre"
refute ring.call(54, 360).any?, "and nothing is painted beyond the 50 pixel outer radius"
