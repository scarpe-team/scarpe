---
manual: styles.strikethrough.single
lines: [1448, 1451]
testability: visual
display: native
----------- app code
Shoes.app width: 400, height: 300 do
  flow(margin_bottom: 20) { @struck = para "H     H", strikethrough: "single", size: 30 }
end
----------- test code
# The gap between the two H's holds no letters, so any ink in it is a line drawn across the text.
# Lines may hang a little below the line box, so look 10 pixels past it (neighbours sit 20 below).
gap_runs = lambda do |name|
  box = layout_of(para(name))
  x = (box.x + box.w / 2).round
  rows = (box.y.floor...(box.y + box.h + 10).ceil).select { |y| pixel_at(x, y).first(3).sum < 600 }
  runs = rows.slice_when { |a, b| b != a + 1 }.to_a
  runs.map { |run| (run.first + run.last) / 2.0 - box.y }
end

height = layout_of(para("@struck")).h
lines = gap_runs.call("@struck")
assert_equal 1, lines.size, "strikethrough: \"single\" draws one line"
assert_operator lines.first, :>, height * 0.3, "through the letters: below their tops"
assert_operator lines.first, :<, height * 0.72, "and above the baseline, where an underline would go"
