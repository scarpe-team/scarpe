----------- app code
Shoes.app do
  stack width: 120 do
    @b = button "Click me", width: "100%" do
      alert "button.width = #{@b.width}\n" +
        "button.style[:width] = #{@b.style[:width]}"
    end
  end
end
----------- test code
assert_equal "100%", button.style[:width], "the percentage string is kept as given"
assert_equal 120, button.width, "\"100%\" of a 120 pixel stack is 120 pixels"
