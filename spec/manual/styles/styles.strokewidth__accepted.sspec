----------- app code
Shoes.app do
  @box = rect 50, 50, 100, 80, strokewidth: 6
  @rule = line 10, 150, 200, 150, strokewidth: 6
  @ring = oval left: 50, top: 150, width: 40, height: 40, strokewidth: 6
end
----------- test code
assert_equal 6, oval("@ring").style[:strokewidth], "an oval keeps its :strokewidth"
assert_equal 6, rect("@box").style[:strokewidth], "a rect keeps its :strokewidth"
assert_equal 6, line("@rule").style[:strokewidth], "a line keeps its :strokewidth"
